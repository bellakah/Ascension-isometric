{
  "name": "ascension-isometric",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "description": "Browser-first isometric RPG/MMO foundation built with TypeScript and Three.js.",
  "packageManager": "pnpm@10.34.5",
  "engines": { "node": ">=22.12.0" },
  "scripts": {
    "dev": "vite",
    "build": "tsc6 -b && vite build",
    "typecheck": "tsc6 -b --pretty false",
    "test": "vitest run",
    "ci": "pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "dependencies": { "fflate": "0.8.2", "three": "0.185.1" },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/three": "0.185.4",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.0.16",
    "vitest": "4.1.10"
  }
}
